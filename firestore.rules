rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserData() {
      return get(currentUserDocPath()).data;
    }

    function currentUserExists() {
      return signedIn() && exists(currentUserDocPath());
    }

    function hasRole(role) {
      return currentUserExists() &&
        currentUserData().roles is list &&
        role in currentUserData().roles;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isActiveUser() {
      return currentUserExists() && currentUserData().status == 'active';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function managesRefillPoint(refillPointId) {
      return currentUserExists() &&
        currentUserData().managedRefillPointIds is list &&
        refillPointId in currentUserData().managedRefillPointIds;
    }

    function managesSponsor(sponsorId) {
      return currentUserExists() &&
        currentUserData().managedSponsorIds is list &&
        sponsorId in currentUserData().managedSponsorIds;
    }

    function publishedResource() {
      return resource.data.status == 'published' &&
        resource.data.visibility == 'public';
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);

      allow create: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.roles == ['customer'] &&
        request.resource.data.accountType == 'customer' &&
        request.resource.data.status == 'active'
      );

      // L'utente può cambiare solo i propri dati anagrafici e la foto.
      // Prima la regola confrontava campo per campo (roles, refillCount,
      // lastRefillAt, lastRefillerUid…): se uno di quei campi mancava nel
      // documento, per esempio lastRefillAt per chi non ha ancora fatto un
      // refill, il confronto andava in errore e ogni salvataggio veniva
      // rifiutato. Con l'elenco dei campi ammessi non conta quali campi
      // esistono, e ruoli, contatori e date restano protetti lo stesso.
      allow update: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'displayName',
          'phone',
          'residence',
          'photoBase64',
          'photoUrl',
          'email',
          'provider',
          'updatedAt'
        ])
      );

      allow delete: if false;
    }

    match /users/{userId}/refill_events/{eventId} {
      allow read: if isAdmin() || isSelf(userId);
      // Gli eventi sono creati dalla Cloud Function con Admin SDK.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /refill_points/{refillPointId} {
      allow read: if publishedResource() || isAdmin() || managesRefillPoint(refillPointId);
      allow create, update: if isAdmin() || managesRefillPoint(refillPointId);
      allow delete: if isAdmin();
    }

    match /bars/{barId} {
      allow read: if true;
      allow create, update: if isAdmin() || hasRole('refill_manager');
      allow delete: if isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow create, update: if isAdmin() || hasRole('sponsor_manager');
      allow delete: if isAdmin();
    }

    match /user_invites/{inviteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /community/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
